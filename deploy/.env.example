# ═══════════════════════════════════════════════════
# Bloomfield BCCC — Production Environment Variables
# ═══════════════════════════════════════════════════
# Copy to /opt/bccc/.env and fill in real values.
# NEVER commit real secrets to version control.
# ═══════════════════════════════════════════════════

# ── Core ──
BCCC_ENV=production
BCCC_PORT=5050

# ── Security (REQUIRED — server will refuse to start without these) ──
BCCC_TOKEN_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_STRING_64_CHARS
BCCC_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── CORS (comma-separated origins, NO wildcard in production) ──
BCCC_CORS_ORIGINS=https://bloomfieldcc.ca,https://www.bloomfieldcc.ca

# ── Database ──
BCCC_DB_DRIVER=sqlite
# For Postgres: BCCC_DB_DRIVER=postgres
# DATABASE_URL=postgresql://user:pass@localhost:5432/bccc

# ── File Uploads ──
BCCC_UPLOAD_BACKEND=local
# For S3/R2:
# BCCC_UPLOAD_BACKEND=s3
# BCCC_S3_BUCKET=bccc-uploads
# BCCC_S3_REGION=auto
# BCCC_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# BCCC_S3_ACCESS_KEY=
# BCCC_S3_SECRET_KEY=

# ── Stripe (optional — enables card payments) ──
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Background Agents ──
BCCC_AGENT_INTERVAL_SECONDS=300
BCCC_AGENT_PENDING_TRANSFER_HOURS=48
BCCC_AGENT_PENDING_TRANSFER_REMINDER_COOLDOWN_HOURS=24
BCCC_AGENT_MARKETPLACE_STALE_DAYS=90
